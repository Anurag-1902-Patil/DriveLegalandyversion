# DriveLegal – Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# No API keys required. Ensure Ollama is running locally with the mistral model.
# Command: ollama run mistral

# ── Optional ───────────────────────────────────────────────────────────────
# Backend host/port (defaults shown)
HOST=0.0.0.0
PORT=8000

# Streamlit backend URL (change if deploying remotely)
BACKEND_URL=http://localhost:8000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Authentication (Email OTP) ─────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password
JWT_SECRET=your_super_secret_key_here

# ── API Integrations (Surepass) ────────────────────────────────────────────
SUREPASS_API_BASE_URL=https://api.surepass.io/api/v1
SUREPASS_AUTH_TOKEN=your_surepass_token
