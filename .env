# DriveLegal – Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# No API keys required. Ensure Ollama is running locally with the mistral model.
# Command: ollama run mistral

# ── Optional ───────────────────────────────────────────────────────────────
# Backend host/port (defaults shown)
HOST=0.0.0.0
PORT=8000

# Streamlit backend URL (change if deploying remotely)
BACKEND_URL=http://localhost:8000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
