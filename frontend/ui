  // Helper: get topic from user query
  function detectTopic(query) {
    const q = query.toLowerCase();
    if (q.includes('speed') || q.includes('fast') || q.includes('limit')) return 'speed';
    if (q.includes('phone') || q.includes('mobile') || q.includes('call') || q.includes('text')) return 'phone';
    if (q.includes('helmet') || q.includes('two wheeler') || q.includes('bike') || q.includes('scooter')) return 'helmet';
    if (q.includes('drink') || q.includes('drunk') || q.includes('alcohol') || q.includes('bac') || q.includes('dui')) return 'drink';
    if (q.includes('seat') || q.includes('belt') || q.includes('seatbelt')) return 'seatbelt';
    if (q.includes('park') || q.includes('parking') || q.includes('tow')) return 'parking';
    if (q.includes('lane') || q.includes('overtake') || q.includes('overtaking')) return 'lane';
    if (q.includes('insurance') || q.includes('insure')) return 'insurance';
    if (q.includes('license') || q.includes('licence') || q.includes('dl ')) return 'license';
    if (q.includes('red light') || q.includes('signal') || q.includes('traffic light')) return 'redlight';
    if (q.includes('hello') || q.includes('hi') || q.includes('hey') || q.includes('good')) return 'greeting';
    if (q.includes('help') || q.includes('what can') || q.includes('how do')) return 'help';
    return 'default';
  }

  // Helper: get current location key
  function getLocation() {
    return document.getElementById('locationSelect').value;
  }

  function getLocationName() {
    const sel = document.getElementById('locationSelect');
    return sel.options[sel.selectedIndex].text;
  }

  // Get response for a query
  function getResponse(query) {
    const topic = detectTopic(query);
    const loc = getLocation();

    if (topic === 'greeting') {
      return { text: `Hello! I'm your DriveLegal assistant for ${getLocationName()}. Ask me about any traffic rule — speed limits, fines, helmet rules, parking, and more. I'll give you location-specific, accurate information.`, penalty: null };
    }
    if (topic === 'help') {
      return { text: `I can help you with traffic rules specific to ${getLocationName()}:\n\n• Speed limits for different road types\n• Phone usage regulations\n• Helmet & seatbelt rules\n• Drink & drive penalties\n• Parking regulations\n• Lane discipline\n• Insurance & license requirements\n• Challan/penalty details\n\nJust type your question!`, penalty: null };
    }

    const cityData = chatResponses[loc] || null;
    const topicData = cityData ? (cityData[topic] || cityData.default) : (chatResponses.generic[topic] || null);

    if (topicData && topicData.text) {
      return { text: topicData.text, penalty: topicData.penalty || null };
    }

    // Fallback for lane, insurance, license, redlight not defined per city
    const genericTopic = chatResponses.generic[topic];
    if (genericTopic) {
      return { text: `For ${getLocationName()}, the general rule applies:\n\n${genericTopic.text}`, penalty: genericTopic.penalty || null };
    }

    return { text: `I don't have specific information on that topic for ${getLocationName()}. Could you try asking about speed limits, phone usage, helmet rules, seatbelt, drink & drive, or parking? I'll give you accurate, location-specific answers.`, penalty: null };
  }

  // === Chat Logic ===
  const chatMessages = document.getElementById('chatMessages');
  const chatInput = document.getElementById('chatInput');
  const typingIndicator = document.getElementById('typingIndicator');

  function getTimeString() {
    const now = new Date();
    return now.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: false });
  }

  function addMessage(type, text, penalty) {
    const div = document.createElement('div');
    div.className = `message ${type}`;

    const avatarIcon = type === 'bot' ? 'fa-shield-halved' : 'fa-user';
    let penaltyHTML = '';
    if (penalty) {
      penaltyHTML = `<div class="msg-penalty"><i class="fa-solid fa-triangle-exclamation"></i> ${penalty}</div>`;
    }

    let locationHTML = '';
    if (type === 'bot') {
      locationHTML = `<div class="msg-location"><i class="fa-solid fa-location-dot"></i> ${getLocationName()}</div>`;
    }

    const formattedText = text.replace(/\n/g, '<br>');

    div.innerHTML = `
      <div class="msg-avatar"><i class="fa-solid ${avatarIcon}"></i></div>
      <div>
        <div class="msg-bubble">
          ${locationHTML}
          ${formattedText}
          ${penaltyHTML}
        </div>
        <div class="msg-time">${getTimeString()}</div>
      </div>
    `;

    chatMessages.appendChild(div);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

