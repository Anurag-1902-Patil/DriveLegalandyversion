    typingIndicator.classList.add('show');
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  function hideTyping() {
    typingIndicator.classList.remove('show');
  }

  function sendMessage(text) {
    if (!text.trim()) return;
    addMessage('user', text.trim(), null);
    chatInput.value = '';

    showTyping();

    const delay = 600 + Math.random() * 800;
    setTimeout(() => {
      hideTyping();
      const response = getResponse(text.trim());
      addMessage('bot', response.text, response.penalty);
    }, delay);
  }

  // Send button
  document.getElementById('sendBtn').addEventListener('click', () => {
    sendMessage(chatInput.value);
  });

  // Enter key
  chatInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage(chatInput.value);
    }
  });

  // Quick reply buttons
  document.querySelectorAll('.quick-reply').forEach(btn => {
    btn.addEventListener('click', () => {
      sendMessage(btn.dataset.query);
    });
  });

  // Rule items — send to chat
  document.querySelectorAll('.rule-item').forEach(item => {
    item.addEventListener('click', () => {
      const rule = item.dataset.rule;
      const queries = {
        speed: 'What is the speed limit here?',
        seatbelt: 'What are the seatbelt fines?',
        phone: 'Is talking on phone allowed while driving?',
        helmet: 'What are the helmet rules?',
        drink: 'What is the penalty for drunk driving?',
        lane: 'What are the lane discipline rules?',
        parking: 'Where can I park legally?',
        insurance: 'What are the insurance requirements?'
      };
      sendMessage(queries[rule] || 'Tell me about this rule');
    });
  });

  // Clear chat
  function clearChat() {
    chatMessages.innerHTML = '';
    showToast('Chat history cleared');
    // Re-add welcome message
    setTimeout(() => {
      addMessage('bot', `Welcome back! I'm your DriveLegal assistant for ${getLocationName()}. How can I help you with traffic rules today?`, null);
    }, 400);
  }

  // Location change handler
  document.getElementById('locationSelect').addEventListener('change', (e) => {
    const name = getLocationName();
    document.getElementById('topbarLocation').textContent = name;
    addMessage('bot', `Location updated to ${name}. All rules and penalties I share will now be specific to this jurisdiction. What would you like to know?`, null);
  });

  // === Challan Calculator ===
  function calculateChallan() {
    const type = document.getElementById('violationType').value;
    const count = parseInt(document.getElementById('offenceCount').value) || 1;
    const repeat = document.getElementById('repeatOffender').value;

    if (!type) {
      showToast('Please select a violation type');
      return;
    }

    const data = penaltyData[type];
    if (!data) return;

    const baseFine = repeat === 'yes' ? data.repeat : data.base;
    const totalFine = baseFine * count;

    // Additional surcharge for repeat offenders
    const surcharge = repeat === 'yes' ? Math.round(totalFine * 0.25) : 0;
    const grandTotal = totalFine + surcharge;

    const resultEl = document.getElementById('challanResult');
    resultEl.innerHTML = `
      <div class="challan-result-row">
        <span class="cr-label">Violation</span>
        <span class="cr-value">${data.label}</span>
      </div>
      <div class="challan-result-row">
        <span class="cr-label">Base Fine (per offence)</span>
        <span class="cr-value">₹${baseFine.toLocaleString('en-IN')}</span>
      </div>
      <div class="challan-result-row">
        <span class="cr-label">Number of Offences</span>
        <span class="cr-value">&times; ${count}</span>
      </div>
      ${repeat === 'yes' ? `<div class="challan-result-row"><span class="cr-label">Repeat Offender Surcharge (25%)</span><span class="cr-value" style="color:var(--danger)">+₹${surcharge.toLocaleString('en-IN')}</span></div>` : ''}
      <div class="challan-result-total">
        <span class="cr-label">Total Estimated Penalty</span>
        <span class="cr-value">₹${grandTotal.toLocaleString('en-IN')}</span>
      </div>
    `;
    resultEl.classList.add('show');
  }

  // === Clock ===
  function updateClock() {
    const now = new Date();
    document.getElementById('topbarTime').textContent = now.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: false });
  }
  updateClock();
  setInterval(updateClock, 10000);

  // === Toast ===
  function showToast(msg) {
    const toast = document.getElementById('toast');
    toast.textContent = msg;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 2500);
  }

  // === Initial welcome message ===
  setTimeout(() => {
    addMessage('bot', `Welcome to DriveLegal! I'm your location-specific driver safety assistant.\n\nI'm currently set to ${getLocationName()}. You can ask me about speed limits, phone usage rules, helmet requirements, drink & drive penalties, seatbelt fines, parking regulations, and more.\n\nAll information is based on the Motor Vehicles (Amendment) Act, 2019 and local enforcement guidelines.`, null);
  }, 500);
</script>

</body>
</html>