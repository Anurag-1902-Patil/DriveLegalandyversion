<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DriveLegal — Driver Safety Chatbot</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
  :root {
    --bg: #F3EDE2;
    --bg-warm: #EDE6D8;
    --card: #FDFAF5;
    --card-hover: #FFF9EF;
    --fg: #2C2418;
    --fg-secondary: #6B5E4F;
    --fg-muted: #9C8E7C;
    --accent: #8B6F4E;
    --accent-light: #C4A97D;
    --accent-bg: #F0E6D4;
    --border: #DDD4C4;
    --border-light: #EAE2D4;
    --danger: #B85C3A;
    --danger-bg: #FDF0EB;
    --success: #5E7A52;
    --success-bg: #EFF4EC;
    --chat-user: #E8DFD0;
    --chat-bot: #FDFAF5;
    --shadow-sm: 0 1px 3px rgba(44,36,24,0.04);
    --shadow-md: 0 2px 8px rgba(44,36,24,0.06);
    --shadow-lg: 0 4px 16px rgba(44,36,24,0.08);
    --radius: 12px;
    --radius-sm: 8px;
    --radius-xs: 6px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--fg);
    height: 100vh;
    overflow: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* Main Layout */
  .dashboard {
    display: grid;
    grid-template-columns: 280px 1fr 300px;
    height: 100vh;
    gap: 0;
  }

  /* Top Bar */
  .topbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: 52px;
    background: var(--card);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    z-index: 100;
  }

  .topbar-logo {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .topbar-logo .logo-icon {
    width: 30px; height: 30px;
    background: var(--accent);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 14px;
  }

  .topbar-logo span {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: 17px;
    color: var(--fg);
    letter-spacing: -0.3px;
  }

  .topbar-logo small {
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    font-size: 10px;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-left: 4px;
  }

  .topbar-center {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--bg);
    border-radius: 20px;
    padding: 4px 14px;
    font-size: 12px;
    color: var(--fg-secondary);
  }

  .topbar-center i { color: var(--success); font-size: 7px; }
  .topbar-center .loc-name { font-weight: 600; color: var(--fg); }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .topbar-time {
    font-size: 12px;
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }

  .topbar-btn {
    width: 32px; height: 32px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--fg-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 13px;
    transition: all 0.2s;
  }

  .topbar-btn:hover {
    background: var(--accent-bg);
    color: var(--accent);
    border-color: var(--accent-light);
  }

  /* Panels */
  .panel-left, .panel-right {
    padding-top: 52px;
    height: 100vh;
    overflow-y: auto;
    background: var(--bg);
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .panel-left {
    border-right: 1px solid var(--border);
  }

  .panel-right {
    border-left: 1px solid var(--border);
  }

  .panel-left::-webkit-scrollbar,
  .panel-right::-webkit-scrollbar {
    width: 4px;
  }

  .panel-left::-webkit-scrollbar-thumb,
  .panel-right::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 4px;
  }

  /* Section Labels */
  .section-label {
    font-size: 9.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.8px;
    color: var(--fg-muted);
    padding: 18px 20px 10px;
  }

  /* Profile Card */
  .profile-card {
    margin: 12px 16px;
    padding: 16px;
    background: var(--card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }

  .profile-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .profile-avatar {
    width: 42px; height: 42px;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--accent), var(--accent-light));
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: 600;
    font-size: 15px;
    flex-shrink: 0;
  }

  .profile-info h3 {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--fg);
    line-height: 1.2;
  }

  .profile-info p {
    font-size: 11px;
    color: var(--fg-muted);
    margin-top: 2px;
  }

  .profile-stats {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 8px;
  }

  .stat-item {
    text-align: center;
    padding: 8px 4px;
    background: var(--bg);
    border-radius: var(--radius-xs);
  }

  .stat-item .val {
    font-size: 16px;
    font-weight: 700;
    color: var(--fg);
    line-height: 1;
  }

  .stat-item .val.danger { color: var(--danger); }
  .stat-item .val.ok { color: var(--success); }

  .stat-item .label {
    font-size: 9px;
    color: var(--fg-muted);
    margin-top: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* License Badge */
  .license-badge {
    margin: 0 16px 8px;
    padding: 10px 14px;
    background: var(--success-bg);
    border: 1px solid #D4E0CC;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11.5px;
    color: var(--success);
  }

  .license-badge i { font-size: 14px; }
  .license-badge span { font-weight: 500; }

  /* Rules List */
  .rules-list {
    padding: 0 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .rule-item {
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    border: 1px solid transparent;
  }

  .rule-item:hover {
    background: var(--card);
    border-color: var(--border-light);
    box-shadow: var(--shadow-sm);
  }

  .rule-icon {
    width: 28px; height: 28px;
    border-radius: 7px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .rule-icon.speed { background: var(--danger-bg); color: var(--danger); }
  .rule-icon.seat { background: #F0EBF5; color: #6B5B8A; }
  .rule-icon.phone { background: #EBF0F5; color: #4A6B8A; }
  .rule-icon.helmet { background: var(--success-bg); color: var(--success); }
  .rule-icon.drink { background: #FDF0EB; color: #C45A3A; }
  .rule-icon.lane { background: #F5F0EB; color: var(--accent); }
  .rule-icon.parking { background: #EBF2F0; color: #4A7A6B; }
  .rule-icon.insurance { background: #F5F2EB; color: #8A7A4A; }

  .rule-text h4 {
    font-size: 12px;
    font-weight: 600;
    color: var(--fg);
    line-height: 1.3;
  }

  .rule-text p {
    font-size: 10.5px;
    color: var(--fg-muted);
    margin-top: 2px;
    line-height: 1.4;
  }

  /* Location Selector */
  .location-selector {
    margin: 0 16px 12px;
    padding: 8px 12px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--fg-secondary);
    cursor: pointer;
    transition: all 0.2s;
  }

  .location-selector:hover {
    border-color: var(--accent-light);
    background: var(--card-hover);
  }

  .location-selector i { color: var(--accent); font-size: 13px; }
  .location-selector select {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    font-family: inherit;
    font-size: 12px;
    color: var(--fg);
    cursor: pointer;
  }

  /* Center Chat */
  .panel-center {
    padding-top: 52px;
    height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--bg-warm);
  }

  .chat-header {
    padding: 14px 24px;
    background: var(--card);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .chat-header-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .chat-header-left .bot-avatar {
    width: 34px; height: 34px;
    border-radius: 9px;
    background: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 14px;
  }

  .chat-header-left h3 {
    font-size: 13.5px;
    font-weight: 600;
  }

  .chat-header-left p {
    font-size: 10.5px;
    color: var(--fg-muted);
    margin-top: 1px;
  }

  .chat-header-actions {
    display: flex;
    gap: 6px;
  }

  .chat-header-actions button {
    width: 30px; height: 30px;
    border-radius: 7px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--fg-muted);
    cursor: pointer;
    font-size: 12px;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .chat-header-actions button:hover {
    background: var(--accent-bg);
    color: var(--accent);
  }

  /* Chat Messages */
  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .chat-messages::-webkit-scrollbar { width: 4px; }
  .chat-messages::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

  .message {
    display: flex;
    gap: 10px;
    max-width: 85%;
    animation: msgIn 0.3s ease;
  }

  @keyframes msgIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .message.bot { align-self: flex-start; }
  .message.user { align-self: flex-end; flex-direction: row-reverse; }

  .msg-avatar {
    width: 28px; height: 28px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .message.bot .msg-avatar {
    background: var(--accent);
    color: #fff;
  }

  .message.user .msg-avatar {
    background: var(--chat-user);
    color: var(--accent);
  }

  .msg-bubble {
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 13px;
    line-height: 1.55;
    position: relative;
  }

  .message.bot .msg-bubble {
    background: var(--chat-bot);
    border: 1px solid var(--border-light);
    border-top-left-radius: 3px;
    color: var(--fg);
  }

  .message.user .msg-bubble {
    background: var(--chat-user);
    border: 1px solid var(--border);
    border-top-right-radius: 3px;
    color: var(--fg);
  }

  .msg-bubble .msg-location {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 10px;
    color: var(--accent);
    background: var(--accent-bg);
    padding: 2px 8px;
    border-radius: 10px;
    margin-bottom: 6px;
    font-weight: 500;
  }

  .msg-bubble .msg-penalty {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 10.5px;
    color: var(--danger);
    background: var(--danger-bg);
    padding: 3px 8px;
    border-radius: 6px;
    margin-top: 6px;
    font-weight: 500;
  }

  .msg-time {
    font-size: 9.5px;
    color: var(--fg-muted);
    margin-top: 4px;
    text-align: right;
  }

  .message.bot .msg-time { text-align: left; }

  /* Quick Replies */
  .quick-replies {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0 24px 10px;
  }

  .quick-reply {
    padding: 6px 14px;
    border-radius: 18px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--fg-secondary);
    font-size: 11.5px;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .quick-reply:hover {
    background: var(--accent-bg);
    border-color: var(--accent-light);
    color: var(--accent);
  }

  /* Chat Input */
  .chat-input-area {
    padding: 12px 24px 16px;
    background: var(--card);
    border-top: 1px solid var(--border);
  }

  .chat-input-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 4px 6px 4px 14px;
    transition: border-color 0.2s;
  }

  .chat-input-wrap:focus-within {
    border-color: var(--accent-light);
  }

  .chat-input-wrap input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    font-family: inherit;
    font-size: 13px;
    color: var(--fg);
  }

  .chat-input-wrap input::placeholder {
    color: var(--fg-muted);
  }

  .chat-input-wrap .voice-btn {
    width: 32px; height: 32px;
    border-radius: 8px;
    border: none;
    background: none;
    color: var(--fg-muted);
    cursor: pointer;
    font-size: 14px;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .chat-input-wrap .voice-btn:hover {
    color: var(--accent);
    background: var(--accent-bg);
  }

  .chat-send-btn {
    width: 34px; height: 34px;
    border-radius: 8px;
    border: none;
    background: var(--accent);
    color: #fff;
    cursor: pointer;
    font-size: 13px;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .chat-send-btn:hover {
    background: #7A5F40;
    transform: scale(1.04);
  }

  .chat-disclaimer {
    font-size: 9.5px;
    color: var(--fg-muted);
    text-align: center;
    margin-top: 8px;
  }

  /* Right Panel — Challan Calculator */
  .challan-card {
    margin: 12px 16px;
    padding: 16px;
    background: var(--card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }

  .challan-card h3 {
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .challan-card h3 i {
    color: var(--accent);
    font-size: 14px;
  }

  .challan-form-group {
    margin-bottom: 10px;
  }

  .challan-form-group label {
    font-size: 10.5px;
    font-weight: 500;
    color: var(--fg-secondary);
    margin-bottom: 5px;
    display: block;
  }

  .challan-form-group select,
  .challan-form-group input {
    width: 100%;
    padding: 8px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    background: var(--bg);
    font-family: inherit;
    font-size: 12px;
    color: var(--fg);
    outline: none;
    transition: border-color 0.2s;
    -webkit-appearance: none;
  }

  .challan-form-group select:focus,
  .challan-form-group input:focus {
    border-color: var(--accent-light);
  }

  .challan-calc-btn {
    width: 100%;
    padding: 9px;
    border: none;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: #fff;
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    margin-top: 4px;
  }

  .challan-calc-btn:hover {
    background: #7A5F40;
  }

  /* Challan Result */
  .challan-result {
    margin-top: 12px;
    padding: 12px;
    background: var(--bg);
    border-radius: var(--radius-sm);
    border: 1px dashed var(--border);
    display: none;
  }

  .challan-result.show { display: block; animation: msgIn 0.3s ease; }

  .challan-result-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 5px 0;
    font-size: 11.5px;
  }

  .challan-result-row .cr-label { color: var(--fg-muted); }
  .challan-result-row .cr-value { font-weight: 600; color: var(--fg); }

  .challan-result-total {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 8px;
    margin-top: 6px;
    border-top: 1px solid var(--border);
    font-size: 13px;
  }

  .challan-result-total .cr-label { font-weight: 600; color: var(--fg); }
  .challan-result-total .cr-value { font-weight: 700; color: var(--danger); font-size: 15px; }

  /* Violation History */
  .violation-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    margin: 0 16px 4px;
    background: var(--card);
    border: 1px solid var(--border-light);
    transition: all 0.2s;
  }

  .violation-item:hover {
    box-shadow: var(--shadow-sm);
  }

  .violation-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .violation-dot.paid { background: var(--success); }
  .violation-dot.pending { background: var(--danger); }

  .violation-info {
    flex: 1;
    min-width: 0;
  }

  .violation-info h4 {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .violation-info p {
    font-size: 10px;
    color: var(--fg-muted);
    margin-top: 1px;
  }

  .violation-amount {
    font-size: 12px;
    font-weight: 700;
    color: var(--fg);
    flex-shrink: 0;
  }

  .violation-status {
    font-size: 9px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 10px;
    flex-shrink: 0;
  }

  .violation-status.paid {
    background: var(--success-bg);
    color: var(--success);
  }

  .violation-status.pending {
    background: var(--danger-bg);
    color: var(--danger);
  }

  /* Safety Score Card */
  .safety-card {
    margin: 12px 16px;
    padding: 16px;
    background: var(--card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    text-align: center;
  }

  .safety-score-ring {
    width: 72px; height: 72px;
    margin: 0 auto 10px;
    position: relative;
  }

  .safety-score-ring svg {
    width: 100%; height: 100%;
    transform: rotate(-90deg);
  }

  .safety-score-ring .ring-bg {
    fill: none;
    stroke: var(--border);
    stroke-width: 5;
  }

  .safety-score-ring .ring-fill {
    fill: none;
    stroke: var(--success);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 188.5;
    stroke-dashoffset: 30;
    transition: stroke-dashoffset 1s ease;
  }

  .safety-score-ring .score-text {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    font-size: 18px;
    font-weight: 700;
    color: var(--fg);
  }

  .safety-card h4 {
    font-size: 12px;
    font-weight: 600;
    color: var(--fg);
  }

  .safety-card p {
    font-size: 10.5px;
    color: var(--fg-muted);
    margin-top: 3px;
    line-height: 1.4;
  }

  /* Typing indicator */
  .typing-indicator {
    display: none;
    align-self: flex-start;
    gap: 10px;
    max-width: 85%;
    animation: msgIn 0.3s ease;
  }

  .typing-indicator.show { display: flex; }

  .typing-dots {
    display: flex;
    gap: 4px;
